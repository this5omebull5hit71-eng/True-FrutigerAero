{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "network", "battery", "clock"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTED"
    },
    "network": {
        "format-wifi": "WiFi: {essid}",
        "format-ethernet": "Ethernet",
        "format-disconnected": "No Net"
    },
    "battery": {
        "format": "BAT {capacity}%"
    },
    "clock": {
        "format": "{:%H:%M - %d/%m}"
    }
}
